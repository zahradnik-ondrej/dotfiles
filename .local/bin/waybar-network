#!/bin/sh
TARGET=${PING_TARGET:-1.1.1.1}
WIFI=$(printf '\xef\x87\xab')
ETH=$(printf '\xef\x83\xa8')

iface=$(ip route show default 2>/dev/null | awk 'NR==1{print $5}')

if [ -z "$iface" ]; then
    printf '{"text":"%s  offline","tooltip":"no default route","class":"disconnected"}\n' "$ETH"
    exit 0
fi

if [ -d "/sys/class/net/$iface/wireless" ]; then
    icon=$WIFI
    name=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
    [ -n "$name" ] || name=$iface
    sig=$(awk -v i="$iface:" 'NR>2 && $1==i {printf "%.0f", $3}' /proc/net/wireless 2>/dev/null)
else
    icon=$ETH
    name=Wired
    sig=""
fi

rtt=$(ping -n -c1 -W1 "$TARGET" 2>/dev/null | awk -F'/' '/^rtt|^round-trip/{printf "%.0f", $5}')
if [ -n "$rtt" ]; then text="$icon  $name  ${rtt}ms"; cls=""; else text="$icon  $name  --"; cls="noping"; fi

addr=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4; exit}')
gw=$(ip route show default 2>/dev/null | awk 'NR==1{print $3}')
tip="$iface\\n$addr\\ngw $gw\\nping $TARGET: ${rtt:-unreachable}${rtt:+ms}"
[ -n "$sig" ] && tip="$name  (${sig}%)\\n$tip"

printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$text" "$tip" "$cls"
