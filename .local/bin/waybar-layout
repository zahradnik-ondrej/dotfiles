#!/bin/sh
trap 'trap - TERM; kill 0' EXIT INT TERM

MAIN=$$
(
    while :; do
        sleep 5
        [ -r /proc/$MAIN/stat ] || exit 0
        [ "$(awk '{print $4}' /proc/$MAIN/stat)" = 1 ] && { kill 0; exit 0; }
    done
) &

last=""

emit() {
    km=$(hyprctl -j devices 2>/dev/null | jq -r '.keyboards[] | select(.main) | .active_keymap' | head -1)
    case "$km" in
        English*) cur=US ;;
        Czech*)   cur=CZ ;;
        "")       cur=?? ;;
        *)        cur=$(printf '%.2s' "$km" | tr '[:lower:]' '[:upper:]') ;;
    esac
    [ "$cur" = "$last" ] && return
    last=$cur
    echo "$cur"
}

emit
sock="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket2.sock"
[ -S "$sock" ] || { while :; do sleep 2; emit; done; }
socat -U - UNIX-CONNECT:"$sock" 2>/dev/null | while IFS= read -r line; do
    case "$line" in activelayout*) emit ;; esac
done
