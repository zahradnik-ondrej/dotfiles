#!/bin/sh
ICON=$(printf '\xef\x8b\x86')
WATCHER="busctl --user --json=short get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems"

find_item() {
    $WATCHER 2>/dev/null | jq -r '.data[]?' | while IFS= read -r it; do
        [ -n "$it" ] || continue
        svc=${it%%/*}; path=/${it#*/}
        id=$(busctl --user --json=short get-property "$svc" "$path" \
             org.kde.StatusNotifierItem Id 2>/dev/null | jq -r '.data // empty')
        [ "$id" = "TelegramDesktop" ] && { printf '%s %s\n' "$svc" "$path"; break; }
    done
}

item=$(find_item)
[ -n "$item" ] || { printf '{"text":"","class":"","tooltip":""}\n'; exit 0; }
svc=${item%% *}; path=${item##* }

case "${1:-}" in
    activate)
        busctl --user call "$svc" "$path" org.kde.StatusNotifierItem Activate ii 0 0 >/dev/null 2>&1
        exit 0
        ;;
esac

icon=$(busctl --user --json=short get-property "$svc" "$path" \
       org.kde.StatusNotifierItem IconName 2>/dev/null | jq -r '.data // empty')

case "$icon" in
    *attention*) cls="unread"; tip="Telegram - unread messages" ;;
    *)           cls="";       tip="Telegram" ;;
esac
printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$ICON" "$cls" "$tip"
